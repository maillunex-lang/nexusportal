{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true
        },
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "id",
        "name",
        "repository",
        "base_branch",
        "platforms",
        "engine"
      ],
      "additionalProperties": true
    },
    "documents": {
      "type": "object",
      "properties": {
        "gdd": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true
        },
        "roadmap": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true
        }
      },
      "required": [
        "gdd",
        "roadmap"
      ],
      "additionalProperties": true
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "minItems": 1,
            "maxItems": 500,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "tasks"
        ],
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "priority": {
            "type": "integer",
            "minimum": -100000,
            "maximum": 100000
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "minItems": 0,
            "maxItems": 500,
            "uniqueItems": true
          },
          "parallel_group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "file_scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "minItems": 0,
            "maxItems": 500,
            "uniqueItems": true
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "minItems": 1,
            "maxItems": 500,
            "uniqueItems": true
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "minItems": 0,
            "maxItems": 500,
            "uniqueItems": true
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "executor_profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "priority",
          "dependencies",
          "parallel_group",
          "file_scopes",
          "acceptance",
          "checks",
          "prompt",
          "executor_profile",
          "branch"
        ],
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "project",
    "documents",
    "stages",
    "tasks"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/project-blueprint-1.0.json",
  "title": "NEXUS Project Blueprint 1.0"
}
