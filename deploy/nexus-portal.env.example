# Конфигурация NEXUS PORTAL (без секретов). Секреты — только файлы в NEXUS_SECRETS_DIR (0600).
NEXUS_DATA_DIR=/var/lib/nexus-portal
NEXUS_SECRETS_DIR=/etc/nexus-portal/secrets
NEXUS_COOKIE_SECURE=1
NEXUS_SESSION_TTL_HOURS=72
# Резервная сверка с GitHub (минуты, 0 — выключить)
NEXUS_SYNC_INTERVAL_MINUTES=15
# Каталог проектов на VPS и публичный адрес загрузок релизов
NEXUS_DEPLOY_ROOT=/srv/nexus
NEXUS_PUBLIC_DOWNLOAD_BASE=
# SSH (если исполнитель ssh): приватный ключ и known_hosts принадлежат пользователю nexus, права 0600
NEXUS_SSH_KEY=/etc/nexus-portal/secrets/id_ed25519
NEXUS_SSH_KNOWN_HOSTS=/etc/nexus-portal/known_hosts
# Порт: __PORT__ (задаётся в nexus-portal.service)
