{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-portal.local/schemas/nexus-blueprint-1.json",
  "title": "NEXUS Project Blueprint 1",
  "description": "Единый план разработки игры или приложения, который ИИ-архитектор формирует после утверждения GDD и дорожной карты. Не зависит от жанра, движка и структуры репозитория. Состояние задач здесь не хранится — его ведёт портал по PR и CI.",
  "type": "object",
  "required": ["format", "blueprint_version", "project", "sources", "phases", "tasks"],
  "properties": {
    "$schema": {"type": "string"},
    "format": {"const": "nexus-blueprint/1"},
    "blueprint_version": {"type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$", "description": "Версия документа; увеличивайте при каждом изменении."},
    "generated_at": {"type": "string", "description": "Дата формирования (ISO 8601)."},
    "generated_by": {"type": "string", "description": "Кто сформировал: например, «ChatGPT — архитектор»."},
    "project": {
      "type": "object",
      "required": ["name", "summary"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1, "description": "1–3 предложения о продукте."},
        "kind": {"type": "string", "description": "game, android, web, server, desktop, library, other — свободное значение."},
        "genre": {"type": "string"},
        "platforms": {"type": "array", "items": {"type": "string"}},
        "tech_stack": {"type": "array", "items": {"type": "string"}, "description": "Движки, языки, фреймворки — как решил архитектор."},
        "repository": {"type": "string", "description": "owner/name; портал подставит свой, если не указан."},
        "default_branch": {"type": "string"}
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "object",
      "required": ["gdd"],
      "properties": {
        "gdd": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}, "description": "Пути или ссылки на утверждённый GDD."},
        "roadmap": {"type": "string"},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}},
        "approved": {"type": "boolean", "description": "true — GDD и дорожная карта утверждены владельцем."}
      },
      "additionalProperties": true
    },
    "conventions": {
      "type": "object",
      "properties": {
        "branch_pattern": {"type": "string", "pattern": "\\{id\\}", "default": "task/{id}"},
        "pr_title_pattern": {"type": "string", "default": "[{id}] {title}"},
        "max_parallel": {"type": "integer", "minimum": 1, "maximum": 20, "default": 3},
        "parallel_within_workstream": {"type": "boolean", "default": false, "description": "false — задачи одного потока выполняются по очереди."},
        "required_checks": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}, "description": "Имена обязательных проверок CI."},
        "definition_of_done": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}},
        "global_rules": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}, "description": "Правила, добавляемые в каждое задание."}
      },
      "additionalProperties": true
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "description": "Этапы в порядке выполнения.",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "goal": {"type": "string"},
          "exit_criteria": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}}
        },
        "additionalProperties": true
      }
    },
    "workstreams": {
      "type": "array",
      "description": "Параллельные линии разработки (например: gameplay, ui, backend).",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,47}$"},
    "nonEmpty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "list": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}},
    "task": {
      "type": "object",
      "required": ["id", "title", "phase", "goal", "acceptance_criteria", "prompt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "phase": {"$ref": "#/$defs/id"},
        "workstream": {"$ref": "#/$defs/id"},
        "priority": {"enum": ["P0", "P1", "P2", "P3"], "default": "P2", "description": "P0 — критично."},
        "type": {"enum": ["feature", "bugfix", "refactor", "infra", "test", "docs", "content", "art", "audio", "research", "release"]},
        "estimate": {"enum": ["XS", "S", "M", "L", "XL"]},
        "executor_hint": {"enum": ["claude", "chatgpt", "codex", "generic", "any"], "default": "any"},
        "goal": {"type": "string", "minLength": 1, "description": "Результат одной фразой."},
        "context": {"type": "string", "description": "Короткий контекст; не копируйте GDD целиком."},
        "gdd_refs": {"$ref": "#/$defs/list"},
        "depends_on": {"$ref": "#/$defs/list", "description": "ID задач, которые должны быть слиты раньше."},
        "conflicts_with": {"$ref": "#/$defs/list", "description": "ID задач, которые нельзя выполнять одновременно с этой."},
        "resources": {"$ref": "#/$defs/list", "description": "Логические области (save-format, player-controller, db-schema). Задачи с общим ресурсом не выполняются параллельно."},
        "deliverables": {"$ref": "#/$defs/list"},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
        "verification": {"$ref": "#/$defs/list", "description": "Как CI проверит результат: тесты, команды."},
        "scope_hints": {"type": "array", "items": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"}, "description": "Необязательные подсказки по путям. Не ограничение: исполнитель сам изучает репозиторий."},
        "out_of_scope": {"$ref": "#/$defs/list"},
        "risks": {"$ref": "#/$defs/list"},
        "prompt": {"type": "string", "minLength": 200, "description": "Подробное задание исполнителю (что, зачем, как, ограничения). Портал оборачивает его стандартной шапкой и правилами."}
      },
      "additionalProperties": true
    }
  }
}
