{
  "schema_version": 1,
  "editorial_status": "design hypotheses informed by genre structure; not measured popularity",
  "genre_blueprints": [
    {
      "id": "mmorpg",
      "core_loop": [
        "Explore world and discover opportunities",
        "Complete group or solo objectives",
        "Improve build and equipment",
        "Trade or cooperate with other players",
        "Return for longer-term social goals"
      ],
      "mvp": [
        "One persistent region",
        "Two distinct combat roles",
        "Quest + dungeon",
        "Basic guild and trading",
        "Reconnection and server persistence"
      ],
      "technical": [
        "Authoritative combat/state",
        "Interest management and region partitions",
        "Durable inventory/transactions",
        "Anti-duplication protections",
        "Reconnect and session recovery"
      ],
      "mobile": [
        "Touch targeting and support-class usability",
        "Readable ability telegraphs",
        "Low-end frame budget",
        "Short optional session objectives"
      ],
      "pitfalls": [
        "Forced daily chores",
        "Veteran-newcomer power gap",
        "Unfair pay-to-win",
        "Long travel without decisions",
        "Loss of progress on disconnect"
      ],
      "questions": [
        "How persistent is the world?",
        "How many simultaneous players share one location?",
        "Are social roles essential?",
        "What happens on disconnect during combat?"
      ]
    },
