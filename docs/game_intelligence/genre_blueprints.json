{
  "schema_version": 1,
  "editorial_status": "design hypotheses informed by genre structure; not measured popularity",
  "genre_blueprints": [
    {
      "id": "mmorpg",
      "core_loop": [
        "Explore world and discover opportunities",
        "Complete group or solo objectives",
        "Improve build and equipment",
        "Trade or cooperate with other players",
        "Return for longer-term social goals"
      ],
      "mvp": [
        "One persistent region",
        "Two distinct combat roles",
        "Quest + dungeon",
        "Basic guild and trading",
        "Reconnection and server persistence"
      ],
      "technical": [
        "Authoritative combat/state",
        "Interest management and region partitions",
        "Durable inventory/transactions",
        "Anti-duplication protections",
        "Reconnect and session recovery"
      ],
      "mobile": [
        "Touch targeting and support-class usability",
        "Readable ability telegraphs",
        "Low-end frame budget",
        "Short optional session objectives"
      ],
      "pitfalls": [
        "Forced daily chores",
        "Veteran-newcomer power gap",
        "Unfair pay-to-win",
        "Long travel without decisions",
        "Loss of progress on disconnect"
      ],
      "questions": [
        "How persistent is the world?",
        "How many simultaneous players share one location?",
        "Are social roles essential?",
        "What happens on disconnect during combat?"
      ]
    },
    {
      "id": "arpg",
      "core_loop": [
        "Enter combat zone",
        "Execute readable skill rotations",
        "Defeat enemy patterns",
        "Collect and compare loot",
        "Improve build and challenge harder encounters"
      ],
      "mvp": [
        "One combat class with multiple viable builds",
        "Three enemy families and boss",
        "Loot rarity + upgrade rules",
        "One cooperative instance",
        "Save/load and controller/touch checks"
      ],
      "technical": [
        "Server-authoritative hits if online",
        "Latency tolerance and animation reconciliation",
        "Deterministic damage rules",
        "Loot table validation",
        "Skill cooldown and resource invariants"
      ],
      "mobile": [
        "Clear joystick/targeting and camera",
        "Telegraphs visible under effects",
        "Low touch-button density",
        "Battery and heat guardrails"
      ],
      "pitfalls": [
        "Visual effect overload",
        "One dominant build",
        "Endless inventory cleanup",
        "Unclear damage feedback",
        "Boss attacks impossible on touch"
      ],
      "questions": [
        "Camera and targeting approach?",
        "Direct or lock-on attacks?",
        "Loot trade allowed?",
        "Co-op latency target?"
      ]
    },
    {
      "id": "4x",
      "core_loop": [
        "Scout the map",
        "Acquire and defend resources",
        "Develop city or base",
        "Research and train units",
        "Negotiate or contest territory"
      ],
      "mvp": [
        "One strategic map",
        "Base construction and resources",
        "Two unit types and PvE targets",
        "Alliance joining and shared objectives",
        "Attack/defense reports"
      ],
      "technical": [
        "Authoritative battle resolution",
        "Time and tick consistency",
        "Anti-cheat and race-safe resource transfers",
        "Alliance permission rules",
        "Map visibility and fog-of-war"
      ],
      "mobile": [
        "Async actions with clear ETA",
        "Readable army orders",
        "Push notifications optional",
        "Fair short-session catch-up"
      ],
      "pitfalls": [
        "Unlimited whale power",
        "Unprotected early-game raids",
        "Long repetitive timers",
        "Punitive timezone-based alliance play",
        "Ads unlike actual gameplay"
      ],
      "questions": [
        "One global world or seasons?",
        "Is PvP opt-in or mandatory?",
        "How are newcomers protected?",
        "Can entire alliances relocate?"
      ]
    },
    {
      "id": "economic_strategy",
      "core_loop": [
        "Spot demand gap",
        "Source or produce goods",
        "Set prices and distribution",
        "Respond to rivals",
        "Reinvest into growth"
      ],
      "mvp": [
        "Three multi-stage goods chains",
        "Warehouses and transport costs",
        "Player/NPC suppliers",
        "Competitive retail catchment areas",
        "Income and cash-flow reports"
      ],
      "technical": [
        "Integer accounting and inventories",
        "Transactional contracts",
        "Market clearing with reproducible rules",
        "Prevent buy/sell duplication",
        "Audit trail and rollback of economic updates"
      ],
      "mobile": [
        "Price adjustment without excessive taps",
        "Readable margins and stockouts",
        "Optional procurement policies",
        "Clear causality for market changes"
      ],
      "pitfalls": [
        "Infinite arbitrage",
        "Omniscient AI rivals",
        "Tedious micromanagement",
        "No real buyer demand",
        "Illusory competition"
      ],
      "questions": [
        "What generates consumer demand?",
        "What knowledge do competing companies have?",
        "How are price changes timed?",
        "How are bankruptcies handled?"
      ]
    },
    {
      "id": "economic_simulation",
      "core_loop": [
        "Set scenario assumptions",
        "Run production and consumer dynamics",
        "Inspect indicators and bottlenecks",
        "Adjust policy or investment",
        "Compare outcomes"
      ],
      "mvp": [
        "Versioned scenario schema",
        "Fixed-seed repeatable simulator",
        "Three production chains",
        "Population cohorts and budgets",
        "Balance charts with validation"
      ],
      "technical": [
        "Conservation and integer money flows",
        "Stable timestep",
        "Seeded pseudo-random events",
        "Replay/golden cases",
        "Sensitivity and stress tests"
      ],
      "mobile": [
        "Summary KPIs and drill-down",
        "Parameter presets",
        "Time-control without precision loss",
        "Exportable results"
      ],
      "pitfalls": [
        "Unexplainable numbers",
        "Non-reproducible outcomes",
        "Profits disconnected from expenses",
        "Simulation speed causing race conditions",
        "Opaque difficulty sliders"
      ],
      "questions": [
        "What is one time step?",
        "How realistic should households be?",
        "Which outcome metrics matter?",
        "How to compare runs fairly?"
      ]
    }
  ]
}
